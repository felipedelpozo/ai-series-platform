{
  "name": "ai-series-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "typescript": "5.9.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "next": "16.3.4",
    "zod": "4.1.12",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-separator": "1.1.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "lucide-react": "1.41.0",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.69.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/node": "26.4.1",
    "@types/bun": "1.4.1",
    "drizzle-orm": "0.45.2",
    "drizzle-kit": "0.31.10",
    "postgres": "3.4.9",
    "dotenv": "17.4.2",
    "@fal-ai/client": "1.10.1",
    "ai": "7.0.92",
    "@ai-sdk/openai": "4.0.58"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "build": "bun run build:web && bun run build:worker",
    "build:web": "bun run --cwd apps/web build",
    "build:worker": "bun run --cwd apps/worker build",
    "typecheck": "bun run --cwd packages/config typecheck && bun run --cwd packages/db typecheck && bun run --cwd packages/fal typecheck && bun run --cwd packages/jobs typecheck && bun run --cwd packages/media typecheck && bun run --cwd packages/prompts typecheck && bun run --cwd packages/generation typecheck && bun run --cwd packages/ai typecheck && bun run --cwd packages/series typecheck && bun run --cwd packages/ui typecheck && bun run --cwd apps/web typecheck && bun run --cwd apps/worker typecheck",
    "lint": "eslint .",
    "test": "bun test",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "prettier": "catalog:"
  }
}
