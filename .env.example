# Runtime environment: development | test | production
APP_ENV=development

# NODE_ENV is usually set by the runtime; uncomment to override.
# NODE_ENV=development

# Optional ports.
# WEB_PORT=3000
# WORKER_PORT=8787

# Optional external subsystems (presence is detected for diagnostics; values stay
# server-side and are never exposed to the client). Used by later features.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_series_platform
# FAL_KEY=
# ASSET_STORE_DIR=
# FFMPEG_PATH=ffmpeg
# OPENAI_API_KEY=
